# HydroMind AI — Backend Environment Variables
# DO NOT commit a real .env file to GitHub — it is in .gitignore.
# This file documents every variable server.js/security.js read from
# process.env. Fill in real values only in Render's environment settings
# (or a local, git-ignored .env) — never here.

# ── Core ─────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://your-app-name.vercel.app
ANTHROPIC_API_KEY=your_anthropic_api_key_here
JWT_SECRET=your_jwt_signing_secret_here

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Zoho SMTP (nodemailer) — used for feedback/contact mail and the
#    trial-conversion reminder emails ────────────────────────────────────
ZOHO_USER=support@yourdomain.com
ZOHO_PASS=your_zoho_app_password_here

# ── Internal webhook/admin auth ─────────────────────────────────────────
WEBHOOK_SECRET=your_generic_webhook_secret_here
RC_WEBHOOK_SECRET=your_revenuecat_webhook_auth_header_value_here

# ── Paddle (direct web checkout billing) ────────────────────────────────
# PADDLE_ENV: "sandbox" or "live". Controls which Paddle API base URL
# server-to-server calls (cancel subscription, customer lookup) use, AND
# which catalog/webhook-secret values below are valid — sandbox and live
# are entirely separate Paddle accounts with different IDs/keys/secrets.
PADDLE_ENV=live
# Server-to-server Paddle API key (Developer Tools > Authentication in the
# Paddle dashboard for the environment named above). Used for the Cancel
# Subscription API call and customer email lookups — never exposed to the
# frontend. Not creatable via API/MCP — generate it in the dashboard.
PADDLE_API_KEY=your_paddle_api_key_here
# Signing secret for the /webhook/paddle notification destination
# (Paddle dashboard > Developer Tools > Notifications > your destination >
# endpoint_secret_key). Used to verify the Paddle-Signature header. Only
# ever set from a destination you (or this migration) created — recreating
# an existing destination rotates this and breaks verification.
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_signing_secret_here
# Paddle Price IDs (pri_...) for the Pro and Enterprise/Team plans, in the
# environment named by PADDLE_ENV above. Used to map incoming webhook line
# items to an entitlement, and to build the checkout link sent in
# trial-ending emails.
PADDLE_PRICE_ID_PRO=pri_your_pro_price_id_here
PADDLE_PRICE_ID_TEAM=pri_your_team_or_enterprise_price_id_here
# Client-side token for Paddle.js (starts with live_ or test_, from Paddle
# dashboard > Developer Tools > Authentication, or the create_client_side_token
# MCP tool). Served to the frontend via GET /api/paddle/client-token so it
# never has to be hardcoded into pricing.html. Safe to expose client-side.
PADDLE_CLIENT_TOKEN=your_paddle_client_side_token_here
# Public site base URL used to build the checkout link in trial-ending
# emails (defaults to https://hydromindai.com if unset). Live Paddle
# checkout will not run on localhost — it only works on a domain-approved
# host, so keep this pointed at the real site even while testing other
# parts of the stack locally.
PUBLIC_SITE_URL=https://hydromindai.com
